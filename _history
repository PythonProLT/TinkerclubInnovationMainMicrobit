 valueParts = parts[1].split(\"-\")\n            if len(valueParts) == 3:\n                timeanddate.set_date(int(valueParts[0]), int(valueParts[1]), int(valueParts[2]))\n                serial.write_line(\"OK DATE \" + timeanddate.date(timeanddate.DateFormat.YYYY_MM_DD))\n            else:\n                serial.write_line(\"ERR DATE\")\n\n        elif line.includes(\"CMD-DST\"):\n            # Forward threshold to sensor, ack immediately\n            if len(parts) >= 2 and int(parts[1]) > 0:\n                radio.send_string(\"DST:\" + parts[1])\n                serial.write_line(\"OK THRESHOLD \" + parts[1])\n            else:\n                serial.write_line(\"ERR THRESHOLD\")\n\n        elif line.includes(\"CMD-DRD\"):\n            # Ask sensor for one reading; response arrives in on_received_string\n            radio.send_string(\"DRD\")\n\n        elif line.includes(\"CMD-TMRD\"):\n            serial.write_line(\"TIME \" + timeanddate.date(timeanddate.DateFormat.YYYY_MM_DD) + \" \" + timeanddate.time(timeanddate.TimeFormat.HHMMSS2_4HR))\n\n        elif line.includes(\"CMD-FR\"):\n            datalogger.delete_log(datalogger.DeleteType.FULL)\n            serial.write_line(\"OK FLASH RESET\")\n\n        else:\n            serial.write_line(\"ERR UNKNOWN\")\n\n        basic.pause(200)\n    basic.pause(100)\nbasic.forever(on_forever)","pxt.json":"{\n    \"name\": \"peoplecounter\",\n    \"description\": \"\",\n    \"dependencies\": {\n        \"core\": \"*\",\n        \"radio\": \"*\",\n        \"microphone\": \"*\",\n        \"pxt-sonar\": \"github:microsoft/pxt-sonar#v0.0.6\",\n        \"pxt-cutebotpro\": \"github:elecfreaks/pxt-cutebot-pro#v2.1.2\",\n        \"vl53l1x-microbit\": \"github:healthywalk/vl53l1x-microbit#v0.0.1\",\n        \"sonarbit\": \"github:elecfreaks/pxt-sonarbit#v1.0.9\",\n        \"microbit-pxt-timeanddate\": \"github:bsiever/microbit-pxt-timeanddate#v2.0.33\",\n        \"datalogger\": \"*\",\n        \"Sound Level in decibels (dB)\"